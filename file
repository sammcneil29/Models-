# ===========================================================================
# BAY LAYOUT
#
# Every articulated face is divided the same way: a wide pier at each end,
# narrow piers between, and as many equal bays as fit near BAY_TARGET_FT. The
# bays are then recessed, and windows are centred inside them -- so window
# spacing follows the structure instead of floating on an arbitrary grid.
# ===========================================================================

def _face_bays(a0, a1, target=None):
    """Clear bay spans across a face running from a0 to a1 (feet)."""
    target = BAY_TARGET_FT if target is None else target
    total = a1 - a0
    if total <= 0.0:
        return []
    # Narrow faces cannot afford full-width piers.
    corner = min(PIER_CORNER_FT, 0.25 * total)
    inner = min(PIER_INNER_FT, 0.12 * total)

    n = max(1, int(round((total - 2.0 * corner + inner) / (target + inner))))
    bay_w = (total - 2.0 * corner - (n - 1) * inner) / n
    while n > 1 and bay_w < MIN_BAY_FT:
        n -= 1
        bay_w = (total - 2.0 * corner - (n - 1) * inner) / n
    if bay_w <= 0.0:
        return []

    out = []
    p = a0 + corner
    for _ in range(n):
        out.append((p, p + bay_w))
        p += bay_w + inner
    return out


def _pier_spans(a0, a1, bays):
    """The solid piers left over between (and outside) the bays."""
    out = []
    cur = a0
    for b0, b1 in bays:
        if b0 > cur + 1e-9:
            out.append((cur, b0))
        cur = b1
    if a1 > cur + 1e-9:
        out.append((cur, a1))
    return out


def _bay_windows(b0, b1, count):
    """`count` evenly spaced window spans inside one bay."""
    width = b1 - b0
    w = width * WIN_BAY_FRAC / count
    gap = (width - count * w) / (count + 1)
    return [(b0 + gap * (i + 1) + w * i, b0 + gap * (i + 1) + w * (i + 1))
            for i in range(count)]


def _floor_sills(z0, z1, sill=None, head=None, win_h=None):
    """Sill heights for the window rows that fit between z0 and z1."""
    sill = WIN_SILL_FT if sill is None else sill
    head = WIN_HEAD_FT if head is None else head
    win_h = WIN_H_FT if win_h is None else win_h
    out = []
    z = z0 + sill
    while z + win_h <= z1 - head:
        out.append(z)
        z += FLOOR_H_FT
    return out


# ===========================================================================
# ROOFS
#
# Defined before the massing table because the tower's articulation has to
# start above whatever the adjoining roofs reach -- and the roofs move when
# SUPPORT_FREE_ROOFS changes the pitch, so those thresholds are derived rather
# than hardcoded.
# ===========================================================================

def _hip_roof_top(x0, x1, y0, y1, rise_ft, pitch_deg):
    """Top rectangle and actual rise of a hip-roof frustum.

    The inset comes from the pitch, then is clamped so the top rectangle never
    degenerates or inverts on a narrow block; the rise is recomputed from the
    clamped inset so the pitch stays honest.
    """
    inset = rise_ft / math.tan(math.radians(pitch_deg))
    inset = min(inset, 0.35 * min(x1 - x0, y1 - y0))
    rise = inset * math.tan(math.radians(pitch_deg))
    return (x0 + inset, x1 - inset, y0 + inset, y1 - inset, rise)


def _active_roof_pitch():
    return ROOF_PITCH_SAFE_DEG if SUPPORT_FREE_ROOFS else ROOF_PITCH_TRUE_DEG


def _roof_specs():
    """(name, x0, x1, y0, y1, base_z, rise) for every tile roof, in feet."""
    return [
        ("wing run roof", RUN_X0, RUN_X1, WING_YF, WING_YB,
         WING_TOP - ROOF_EMBED_FT, WING_ROOF_RISE_FT),
        ("left pavilion roof", PAVL_X0, PAVL_X1, WING_YF, WING_YB,
         PAV_TOP - ROOF_EMBED_FT, WING_ROOF_RISE_FT),
        ("right pavilion roof", PAVR_X0, PAVR_X1, WING_YF, WING_YB,
         PAV_TOP - ROOF_EMBED_FT, WING_ROOF_RISE_FT),
        ("porte-cochere roof", -PORTE_HX, PORTE_HX, PORTE_YF, SHAFT_YF,
         PORTE_TOP - ROOF_EMBED_FT, PORTE_ROOF_RISE_FT),
    ]


def _roof_peak_ft(only=None):
    """Highest point any of the named roofs reaches, at the pitch in effect."""
    pitch = _active_roof_pitch()
    peaks = [0.0]
    for name, x0, x1, y0, y1, base, rise in _roof_specs():
        if only is not None and name not in only:
            continue
        peaks.append(base + ROOF_EMBED_FT
                     + _hip_roof_top(x0, x1, y0, y1, rise, pitch)[4])
    return max(peaks)


def _articulation_start_ft(only):
    """Where facade articulation can begin above a set of roofs."""
    return math.ceil(_roof_peak_ft(only)) + 2.0


# ===========================================================================
# MASSING TABLE
#
# Each entry is one axis-aligned block plus, per exposed face, an ordered list
# of "layers" cut into it:
#
#   {"kind": "bay", "bands": [(z0, z1), ...], "depth": <ft>}
#       recess every bay on that face, across those vertical bands
#   {"kind": "win", "bands": [(z0, z1), ...], "per_bay": n, "behind": <ft>,
#    "arch": "all"|"first"|"last"|None, "depth": <ft>, "h": <ft>}
#       window rows inside each bay. "behind" is the bay depth the opening
#       already sits in, so its own recess is measured from the bay's back
#       wall rather than the outer face.
#
# Faces omitted here are buried by an adjoining block and are left blank:
# the wing run's flanks, the tower's flanks below the wing roofline, the
# pavilions' inboard ends, and the arcaded ground floor behind the porch.
# ===========================================================================

def _wing_faces(top_ft, flanks):
    """Standard wing articulation: ground-floor loggia, plain floors above."""
    bays = {"kind": "bay", "bands": [(0.0, top_ft)], "depth": BAY_DEPTH_LOW_FT}
    loggia = {"kind": "win", "bands": [(0.0, 20.0)], "per_bay": 1,
              "behind": BAY_DEPTH_LOW_FT, "depth": LOGGIA_DEPTH_FT,
              "arch": "all", "h": LOGGIA_H_FT, "sill": 3.0, "head": 3.0}
    upper = {"kind": "win", "bands": [(20.0, top_ft)], "per_bay": 1,
             "behind": BAY_DEPTH_LOW_FT, "arch": None}
    return dict((f, [bays, loggia, upper]) for f in flanks)


def _masses():
    lap = MERGE_LAP_FT
    sx = SHAFT_HX

    # The tower's flanks are buried by the wings and their roofs up to here,
    # and its front by the porch roof -- so articulation starts above each.
    flank_z0 = _articulation_start_ft(
        ("wing run roof", "left pavilion roof", "right pavilion roof"))
    front_z0 = _articulation_start_ft(("porte-cochere roof",))

    masses = [
        {
            "name": "wing_run",
            "x": (RUN_X0, RUN_X1), "y": (WING_YF, WING_YB), "z": (0.0, WING_TOP),
            "faces": _wing_faces(WING_TOP, ["front", "back"]),
        },
        {
            "name": "pavilion_left",
            "x": (PAVL_X0, PAVL_X1), "y": (WING_YF, WING_YB), "z": (0.0, PAV_TOP),
            "faces": _wing_faces(PAV_TOP, ["front", "back", "left"]),
        },
        {
            "name": "pavilion_right",
            "x": (PAVR_X0, PAVR_X1), "y": (WING_YF, WING_YB), "z": (0.0, PAV_TOP),
            "faces": _wing_faces(PAV_TOP, ["front", "back", "right"]),
        },
        {
            "name": "porte_cochere",
            "x": (-PORTE_HX, PORTE_HX), "y": (PORTE_YF, SHAFT_YF + lap),
            "z": (0.0, PORTE_TOP),
            "faces": {},
        },
        {
            "name": "tower_shaft",
            "x": (-sx, sx), "y": (SHAFT_YF, SHAFT_YB), "z": (0.0, SHAFT_TOP),
            "faces": {
                # The sign band is left solid on purpose: recessing it would
                # leave the plaque bridging an open bay.
                "front": [
                    {"kind": "bay",
                     "bands": [(front_z0, SIGN_Z0), (SIGN_Z1, SHAFT_TOP)],
                     "depth": BAY_DEPTH_FT},
                    {"kind": "win", "bands": [(front_z0, SIGN_Z0)], "per_bay": 1,
                     "behind": BAY_DEPTH_FT, "arch": "first"},
                ],
                "back": [
                    {"kind": "bay", "bands": [(flank_z0, SHAFT_TOP)],
                     "depth": BAY_DEPTH_FT},
                    {"kind": "win", "bands": [(flank_z0, SHAFT_TOP)],
                     "per_bay": 1, "behind": BAY_DEPTH_FT, "arch": "first"},
                ],
                "left": [
                    {"kind": "bay", "bands": [(flank_z0, SHAFT_TOP)],
                     "depth": BAY_DEPTH_FT},
                    {"kind": "win", "bands": [(flank_z0, SHAFT_TOP)],
                     "per_bay": 1, "behind": BAY_DEPTH_FT, "arch": "first"},
                ],
                "right": [
                    {"kind": "bay", "bands": [(flank_z0, SHAFT_TOP)],
                     "depth": BAY_DEPTH_FT},
                    {"kind": "win", "bands": [(flank_z0, SHAFT_TOP)],
                     "per_bay": 1, "behind": BAY_DEPTH_FT, "arch": "first"},
                ],
            },
        },
        {
            # The arcade level: a ring of tall, deep arched openings. No bay
            # recesses here -- the arcade is the articulation.
            "name": "setback_1",
            "x": (-SB1_HX, SB1_HX), "y": (-SB1_HY, SB1_HY),
            "z": (SHAFT_TOP - lap, SB1_TOP),
            "faces": dict(
                (f, [{"kind": "win", "bands": [(SHAFT_TOP, SB1_TOP)],
                      "per_bay": 1, "depth": ARCADE_DEPTH_FT, "arch": "all",
                      "h": ARCADE_H_FT, "sill": 3.0, "head": 3.0}])
                for f in ("front", "back", "left", "right")),
        },
        {
            "name": "setback_2",
            "x": (-SB2_HX, SB2_HX), "y": (-SB2_HY, SB2_HY),
            "z": (SB1_TOP - lap, SB2_TOP),
            "faces": dict(
                (f, [{"kind": "bay", "bands": [(SB1_TOP, SB2_TOP)],
                      "depth": BAY_DEPTH_LOW_FT},
                     {"kind": "win", "bands": [(SB1_TOP, SB2_TOP)],
                      "per_bay": 1, "behind": BAY_DEPTH_LOW_FT, "arch": "all",
                      "sill": 3.0, "head": 3.0}])
                for f in ("front", "back", "left", "right")),
        },
        {
            # Solid for now; cut_parapet() hollows it into a tray so the wall
            # between the pier caps reads as a parapet rather than a slab.
            "name": "crown_parapet",
            "x": (-SB2_HX, SB2_HX), "y": (-SB2_HY, SB2_HY),
            "z": (SB2_TOP - lap, PARAPET_TOP),
            "faces": {},
        },
        {
            "name": "penthouse",
            "x": (-PENT_HX, PENT_HX), "y": (-PENT_HY, PENT_HY),
            "z": (SB2_TOP - lap, PENT_TOP),
            "faces": {},
        },
    ]
    return masses + _pier_caps()


def _pier_caps():
    """Stepped caps continuing the piers past the crown parapet.

    Derived from setback-2's own bay layout, so the caps land exactly on the
    piers below them. Corner piers carry the 199 ft height; the intermediate
    ones stop lower, which is what gives the crown its stepped silhouette.
    """
    out = []
    d = CAP_DEPTH_FT
    z0 = SB2_TOP - MERGE_LAP_FT

    faces = [
        ("front", (-SB2_HX, SB2_HX), lambda s: (s, (-SB2_HY, -SB2_HY + d))),
        ("back", (-SB2_HX, SB2_HX), lambda s: (s, (SB2_HY - d, SB2_HY))),
        ("left", (-SB2_HY, SB2_HY), lambda s: ((-SB2_HX, -SB2_HX + d), s)),
        ("right", (-SB2_HY, SB2_HY), lambda s: ((SB2_HX - d, SB2_HX), s)),
    ]
    for face, (a0, a1), place in faces:
        piers = _pier_spans(a0, a1, _face_bays(a0, a1))
        for i, span in enumerate(piers):
            corner = (i == 0 or i == len(piers) - 1)
            xs, ys = place(span)
            out.append({
                "name": "cap_%s_%d" % (face, i),
                "x": xs, "y": ys,
                "z": (z0, CAP_CORNER_TOP if corner else CAP_INNER_TOP),
                "faces": {},
            })
    return out


# ===========================================================================
# SMALL HELPERS (pure python -- no Fusion calls, so they are unit-testable)
# ===========================================================================

def _cm(mm_value):
    """Model millimetres -> Fusion internal centimetres."""
    return mm_value * 0.1


def _log(app, message):
    try:
        app.log("[HollywoodTower] " + message)
    except Exception:
        print("[HollywoodTower] " + message)


def _raw_bounds_ft():
    """Real-world extents of the modelled mass, in feet."""
    ms = _masses()
    xs = [v for m in ms for v in m["x"]]
    ys = [v for m in ms for v in m["y"]]
    zs = [v for m in ms for v in m["z"]]
    return (min(xs), max(xs), min(ys), max(ys), max(min(zs), 0.0), max(zs))


def _compute_scale():
    """Largest scale that still fits the bed, plus the resulting envelope."""
    x0, x1, y0, y1, z0, z1 = _raw_bounds_ft()
    w_mm = (x1 - x0) * FT_MM
    d_mm = (y1 - y0) * FT_MM
    h_mm = (z1 - z0) * FT_MM

    base_t = BASE_T_MM if INCLUDE_BASE else 0.0
    base_m = 2.0 * BASE_MARGIN_MM if INCLUDE_BASE else 0.0

    usable_x = BED_X_MM - BED_CLEARANCE_MM - base_m
    usable_y = BED_Y_MM - BED_CLEARANCE_MM - base_m
    usable_z = BED_Z_MM - BED_CLEARANCE_MM - base_t

    scale = min(usable_x / w_mm, usable_y / d_mm, usable_z / h_mm)
    envelope = (w_mm * scale + base_m,
                d_mm * scale + base_m,
                h_mm * scale + base_t)
    return scale, envelope, (x0, x1, y0, y1, z0, z1)


def _narrowest_bay_ft():
    """Smallest clear bay anywhere on the building -- drives the size audit."""
    widths = []
    for m in _masses():
        for face in m.get("faces", {}):
            a0, a1 = (m["x"] if face in ("front", "back") else m["y"])
            for b0, b1 in _face_bays(a0, a1):
                widths.append(b1 - b0)
    return min(widths) if widths else 0.0


def _audit_features(scale, app):
    """Report anything that lands under the nozzle's comfort zone."""
    def L(ft):
        return ft * FT_MM * scale

    narrow_bay = _narrowest_bay_ft()
    checks = [
        ("narrowest bay", L(narrow_bay)),
        ("narrowest window", L(narrow_bay * WIN_BAY_FRAC)),
        ("inner pier", L(PIER_INNER_FT)),
        ("bay recess depth", L(BAY_DEPTH_FT)),
        ("parapet thickness", L(PARAPET_T_FT)),
        ("pier cap depth", L(CAP_DEPTH_FT)),
        ("sign plaque relief", L(SIGN_PROJ)),
        ("entry arch width", L(FRONT_ARCH["radius"] * 2.0)),
        ("window recess depth", WINDOW_RECESS_MM),
        ("sign emboss relief", SIGN_EMBOSS_MM),
    ]
    undersized = []
    for name, value in checks:
        flag = "   <-- below MIN_FEATURE_MM" if value < MIN_FEATURE_MM else ""
        if flag:
            undersized.append(name)
        _log(app, "  feature check: %-22s %7.2f mm%s" % (name, value, flag))
    return undersized


# ===========================================================================
# BUILDER
# ===========================================================================

class TowerBuilder(object):
    """Builds the whole model as one temporary B-Rep solid, then commits it.

    Working through TemporaryBRepManager rather than sketches + features keeps
    this fast (a few hundred booleans instead of a few hundred timeline
    features) and deterministic. The only real Fusion features used are the
    roof lofts and the optional sign lettering, which have no temp-BRep
    primitive equivalent; both degrade gracefully if they fail.
    """

    BLEED_MM = 0.4      # cutters poke this far outside the wall they cut

    def __init__(self, app, root, scale, x_shift_ft, y_shift_ft, z_offset_mm):
        self.app = app
        self.root = root
        self.tbm = adsk.fusion.TemporaryBRepManager.get()
        self.scale = scale              # model mm per real mm
        self.x_shift_ft = x_shift_ft
        self.y_shift_ft = y_shift_ft
        self.z_offset_mm = z_offset_mm
        self.main = None
        self.stats = {"masses": 0, "bays": 0, "windows": 0,
                      "arches": 0, "blast": 0, "failed": 0}

    # -- coordinate conversion (feet -> model mm) ---------------------------

    def L(self, ft):
        """A pure length in feet -> model millimetres."""
        return ft * FT_MM * self.scale

    def X(self, ft):
        return self.L(ft + self.x_shift_ft)

    def Y(self, ft):
        return self.L(ft + self.y_shift_ft)

    def Z(self, ft):
        return self.L(ft) + self.z_offset_mm

    # -- primitives ---------------------------------------------------------

    def box_mm(self, x0, x1, y0, y1, z0, z1):
        """Axis-aligned box from model-millimetre bounds."""
        centre = adsk.core.Point3D.create(
            _cm((x0 + x1) * 0.5), _cm((y0 + y1) * 0.5), _cm((z0 + z1) * 0.5))
        obb = adsk.core.OrientedBoundingBox3D.create(
            centre,
            adsk.core.Vector3D.create(1.0, 0.0, 0.0),   # length along +X
            adsk.core.Vector3D.create(0.0, 1.0, 0.0),   # width  along +Y
            _cm(abs(x1 - x0)), _cm(abs(y1 - y0)), _cm(abs(z1 - z0)))
        return self.tbm.createBox(obb)

    def box_ft(self, x0, x1, y0, y1, z0, z1):
        """Axis-aligned box from real-world foot bounds."""
        return self.box_mm(self.X(x0), self.X(x1),
                           self.Y(y0), self.Y(y1),
                           self.Z(z0), self.Z(z1))

    def cylinder_ft(self, p0_ft, p1_ft, radius_ft):
        """Cylinder between two points given in feet."""
        p0 = adsk.core.Point3D.create(
            _cm(self.X(p0_ft[0])), _cm(self.Y(p0_ft[1])), _cm(self.Z(p0_ft[2])))
        p1 = adsk.core.Point3D.create(
            _cm(self.X(p1_ft[0])), _cm(self.Y(p1_ft[1])), _cm(self.Z(p1_ft[2])))
        r = _cm(self.L(radius_ft))
        return self.tbm.createCylinderOrCone(p0, r, p1, r)

    # -- booleans -----------------------------------------------------------

    def _boolean(self, target, tool, kind, what):
        ok = self.tbm.booleanOperation(target, tool, kind)
        if not ok:
            self.stats["failed"] += 1
            _log(self.app, "WARNING: boolean failed on '%s' -- skipped." % what)
        return ok

    def union(self, target, tool, what="union"):
        return self._boolean(target, tool,
                             adsk.fusion.BooleanTypes.UnionBooleanType, what)

    def cut(self, target, tool, what="cut"):
        return self._boolean(target, tool,
                             adsk.fusion.BooleanTypes.DifferenceBooleanType, what)

    # -- face-relative openings --------------------------------------------
    #
    # An "opening" is described in face-local terms: a span along the face, a
    # depth range measured inwards from it, and a height range. That one
    # abstraction covers bay recesses, rectangular windows, arched windows,
    # loggias and the arcade, on any of the four faces.

    @staticmethod
    def _is_x_face(face):
        return face in ("left", "right")

    def _depth_range_mm(self, face, x0, x1, y0, y1, depth_mm):
        """(near, far) model-mm range along the inward face normal."""
        bleed = self.BLEED_MM
        if face == "front":
            return (y0 - bleed, y0 + depth_mm)
        if face == "back":
            return (y1 - depth_mm, y1 + bleed)
        if face == "left":
            return (x0 - bleed, x0 + depth_mm)
        if face == "right":
            return (x1 - depth_mm, x1 + bleed)
        raise ValueError("unknown face %r" % face)

    def _face_box(self, face, s0, s1, d0, d1, z0, z1):
        """Box from face-local (span, depth, height) millimetre bounds."""
        if self._is_x_face(face):
            return self.box_mm(d0, d1, s0, s1, z0, z1)
        return self.box_mm(s0, s1, d0, d1, z0, z1)

    def _opening_tools(self, face, s0, s1, d0, d1, z0, z1, arched):
        """Cutting bodies for one opening. An arched head is a box up to the
        springing line plus a horizontal-axis cylinder -- which prints as a
        short self-supporting bridge rather than a flat overhang."""
        tools = []
        radius = (s1 - s0) * 0.5 if arched else 0.0
        spring = z1 - radius
        if spring > z0 + 1e-9:
            tools.append(self._face_box(face, s0, s1, d0, d1, z0, spring))
        if arched:
            mid = (s0 + s1) * 0.5
            if self._is_x_face(face):
                p0 = adsk.core.Point3D.create(_cm(d0), _cm(mid), _cm(spring))
                p1 = adsk.core.Point3D.create(_cm(d1), _cm(mid), _cm(spring))
            else:
                p0 = adsk.core.Point3D.create(_cm(mid), _cm(d0), _cm(spring))
                p1 = adsk.core.Point3D.create(_cm(mid), _cm(d1), _cm(spring))
            tools.append(self.tbm.createCylinderOrCone(p0, _cm(radius),
                                                       p1, _cm(radius)))
        return tools

    # =======================================================================
    # STEP 1 -- massing, with bays and windows cut per block
    # =======================================================================

    def build_masses(self):
        for mass in _masses():
            body = self.box_ft(mass["x"][0], mass["x"][1],
                               mass["y"][0], mass["y"][1],
                               mass["z"][0], mass["z"][1])
            # Cutting while the block is still a plain box is far cheaper than
            # cutting the assembled solid.
            self._articulate(body, mass)

            if self.main is None:
                self.main = body
            else:
                self.union(self.main, body, "mass:" + mass["name"])
            self.stats["masses"] += 1
        _log(self.app, "  %d blocks, %d bay recesses, %d openings"
             % (self.stats["masses"], self.stats["bays"], self.stats["windows"]))

    def _articulate(self, body, mass):
        x0, x1 = self.X(mass["x"][0]), self.X(mass["x"][1])
        y0, y1 = self.Y(mass["y"][0]), self.Y(mass["y"][1])

        for face, layers in mass.get("faces", {}).items():
            span_ft = mass["x"] if not self._is_x_face(face) else mass["y"]
            bays = _face_bays(span_ft[0], span_ft[1])
            if not bays:
                continue
            to_mm = self.X if not self._is_x_face(face) else self.Y

            for layer in layers:
                kind = layer.get("kind", "win")
                if kind == "bay" and not INCLUDE_BAYS:
                    continue
                if kind == "win" and not INCLUDE_WINDOWS:
                    continue

                extra = layer.get("depth")
                extra_mm = self.L(extra) if extra is not None else WINDOW_RECESS_MM
                depth_mm = self.L(layer.get("behind", 0.0)) + extra_mm
                d0, d1 = self._depth_range_mm(face, x0, x1, y0, y1, depth_mm)

                for band in layer["bands"]:
                    if kind == "bay":
                        for b0, b1 in bays:
                            self._cut_opening(
                                body, face, to_mm(b0), to_mm(b1), d0, d1,
                                self.Z(band[0]), self.Z(band[1]), False,
                                "bay", mass["name"])
                        continue

                    win_h = layer.get("h", WIN_H_FT)
                    rows = _floor_sills(band[0], band[1], layer.get("sill"),
                                        layer.get("head"), win_h)
                    if not rows:
                        continue
                    arch = layer.get("arch")
                    for b0, b1 in bays:
                        for w0, w1 in _bay_windows(b0, b1,
                                                   layer.get("per_bay", 1)):
                            for i, sill in enumerate(rows):
                                arched = (arch == "all"
                                          or (arch == "first" and i == 0)
                                          or (arch == "last" and i == len(rows) - 1))
                                self._cut_opening(
                                    body, face, to_mm(w0), to_mm(w1), d0, d1,
                                    self.Z(sill), self.Z(sill + win_h), arched,
                                    "win", mass["name"])

    def _cut_opening(self, body, face, s0, s1, d0, d1, z0, z1, arched,
                     kind, owner):
        tools = self._opening_tools(face, s0, s1, d0, d1, z0, z1, arched)
        ok = True
        for t in tools:
            ok = self.cut(body, t, "%s:%s:%s" % (kind, owner, face)) and ok
        if ok:
            self.stats["bays" if kind == "bay" else "windows"] += 1
            if arched:
                self.stats["arches"] += 1

    # =======================================================================
    # STEP 2 -- crown parapet tray
    # =======================================================================

    def cut_parapet(self):
        """Hollow the crown into an open roof tray.

        Cut as four strips around the penthouse rather than one central box,
        so the penthouse survives it. The cut starts at the setback-2 deck and
        runs past the tallest cap, so it opens upward and costs nothing in
        printability -- and where it clips the inboard half of a pier cap, the
        cap simply steps narrower as it rises, which is what the real crown
        does anyway.
        """
        ix, iy = SB2_HX - PARAPET_T_FT, SB2_HY - PARAPET_T_FT   # tray inside
        px, py = PENT_HX, PENT_HY                               # penthouse
        z0, z1 = SB2_TOP, CAP_CORNER_TOP + 10.0
        strips = [
            (-ix, ix, -iy, -py),    # in front of the penthouse
            (-ix, ix, py, iy),      # behind it
            (-ix, -px, -py, py),    # left of it
            (px, ix, -py, py),      # right of it
        ]
        for x0, x1, y0, y1 in strips:
            if x1 - x0 <= 0.0 or y1 - y0 <= 0.0:
                continue
            self.cut(self.main, self.box_ft(x0, x1, y0, y1, z0, z1),
                     "crown parapet tray")

    # =======================================================================
    # STEP 3 -- sign plaque
    # =======================================================================

    def add_sign_plaque(self):
        plaque = self.box_ft(-SIGN_HX, SIGN_HX,
                             SHAFT_YF - SIGN_PROJ, SHAFT_YF + MERGE_LAP_FT,
                             SIGN_Z0, SIGN_Z1)
        self.union(self.main, plaque, "sign plaque")

    def sign_face_y_mm(self):
        return self.Y(SHAFT_YF - SIGN_PROJ)

    # =======================================================================
    # STEP 4 -- entry arches
    # =======================================================================

    def cut_arches(self):
        a = FRONT_ARCH
        self.cut(self.main,
                 self.box_ft(-a["hx"], a["hx"], a["y0"], a["y1"], 0.0, a["spring_z"]),
                 "front arch shaft")
        self.cut(self.main,
                 self.cylinder_ft((0.0, a["y0"], a["spring_z"]),
                                  (0.0, a["y1"], a["spring_z"]), a["radius"]),
                 "front arch crown")

        c = CROSS_ARCH
        self.cut(self.main,
                 self.box_ft(c["x0"], c["x1"],
                             c["cy"] - c["radius"], c["cy"] + c["radius"],
                             0.0, c["spring_z"]),
                 "cross arch shaft")
        self.cut(self.main,
                 self.cylinder_ft((c["x0"], c["cy"], c["spring_z"]),
                                  (c["x1"], c["cy"], c["spring_z"]), c["radius"]),
                 "cross arch crown")

    # =======================================================================
    # STEP 5 -- lightning damage
    # =======================================================================

    def cut_blast(self):
        for x0, x1, y0, y1, z0 in BLAST_BOXES_FT:
            if self.cut(self.main, self.box_ft(x0, x1, y0, y1, z0, BLAST_TOP_FT),
                        "blast void"):
                self.stats["blast"] += 1

    # =======================================================================
    # STEP 6 -- ground slab
    # =======================================================================

    def add_base(self, bounds_ft):
        m = BASE_MARGIN_MM
        slab = self.box_mm(self.X(bounds_ft[0]) - m, self.X(bounds_ft[1]) + m,
                           self.Y(bounds_ft[2]) - m, self.Y(bounds_ft[3]) + m,
                           0.0, BASE_T_MM + self.L(MERGE_LAP_FT))
        self.union(self.main, slab, "ground slab")

    # =======================================================================
    # STEP 7 -- commit the temp solid into the component
    # =======================================================================

    def commit(self):
        bodies = self.root.bRepBodies
        try:
            body = bodies.add(self.main)
        except Exception:
            # Parametric design: a BaseFeature is required to host the body.
            base = self.root.features.baseFeatures.add()
            base.startEdit()
            try:
                body = bodies.add(self.main, base)
            finally:
                base.finishEdit()
        body.name = "HollywoodTowerHotel"
        return body

    # =======================================================================
    # STEP 8 -- roofs (real Fusion lofts: no temp-BRep frustum primitive)
    # =======================================================================

    def _plane_at(self, base_plane, axis, value_mm):
        """Offset construction plane, with the offset sign verified rather than
        assumed -- Fusion's base-plane normals are easy to get backwards."""
        planes = self.root.constructionPlanes
        for sgn in (1.0, -1.0):
            ci = planes.createInput()
            ci.setByOffset(base_plane,
                           adsk.core.ValueInput.createByReal(sgn * _cm(value_mm)))
            pl = planes.add(ci)
            origin = pl.geometry.origin
            got = {"x": origin.x, "y": origin.y, "z": origin.z}[axis]
            if abs(got - _cm(value_mm)) < 1e-6:
                return pl
            pl.deleteMe()
        raise RuntimeError("could not place a construction plane at %s=%.3f mm"
                           % (axis, value_mm))

    def _rect_profile_at_z(self, x0, x1, y0, y1, z_mm):
        sk = self.root.sketches.add(
            self._plane_at(self.root.xYConstructionPlane, "z", z_mm))
        sk.isComputeDeferred = True
        p0 = sk.modelToSketchSpace(
            adsk.core.Point3D.create(_cm(x0), _cm(y0), _cm(z_mm)))
        p1 = sk.modelToSketchSpace(
            adsk.core.Point3D.create(_cm(x1), _cm(y1), _cm(z_mm)))
        sk.sketchCurves.sketchLines.addTwoPointRectangle(p0, p1)
        sk.isComputeDeferred = False
        if sk.profiles.count == 0:
            raise RuntimeError("rectangle sketch produced no profile")
        return sk.profiles.item(0)

    def build_roofs(self, target_body):
        pitch = _active_roof_pitch()
        made = []
        for name, x0, x1, y0, y1, z_base_ft, rise_ft in _roof_specs():
            tx0, tx1, ty0, ty1, rise = _hip_roof_top(x0, x1, y0, y1, rise_ft, pitch)
            try:
                lower = self._rect_profile_at_z(
                    self.X(x0), self.X(x1), self.Y(y0), self.Y(y1),
                    self.Z(z_base_ft))
                upper = self._rect_profile_at_z(
                    self.X(tx0), self.X(tx1), self.Y(ty0), self.Y(ty1),
                    self.Z(z_base_ft + ROOF_EMBED_FT + rise))
                lofts = self.root.features.loftFeatures
                li = lofts.createInput(
                    adsk.fusion.FeatureOperations.NewBodyFeatureOperation)
                li.loftSections.add(lower)
                li.loftSections.add(upper)
                li.isSolid = True
                feat = lofts.add(li)
                made.extend([feat.bodies.item(i) for i in range(feat.bodies.count)])
                _log(self.app, "  %s: pitch %.0f deg, rise %.1f ft"
                     % (name, pitch, rise))
            except Exception:
                _log(self.app, "WARNING: %s loft failed, roof left flat:\n%s"
                     % (name, traceback.format_exc()))

        if not made:
            return
        tools = adsk.core.ObjectCollection.create()
        for b in made:
            tools.add(b)
        ci = self.root.features.combineFeatures.createInput(target_body, tools)
        ci.operation = adsk.fusion.FeatureOperations.JoinFeatureOperation
        ci.isKeepToolBodies = False
        self.root.features.combineFeatures.add(ci)

    # =======================================================================
    # STEP 9 -- optional embossed lettering
    # =======================================================================

    def emboss_sign_text(self, target_body):
        """Best effort. True-scale lettering would be ~1 mm tall, so this is
        deliberately oversized -- it is the most recognisable single feature of
        the building, and illegible lettering is worse than none."""
        band_mm = self.L(SIGN_Z1 - SIGN_Z0)
        width_mm = self.L(SIGN_HX * 2.0)
        n = len(SIGN_TEXT_LINES)
        cap_mm = min(band_mm / (n * 1.9), width_mm / 11.0)
        if cap_mm < 2.5:
            _log(self.app, "sign text skipped: %.2f mm cap height is too small "
                           "to print legibly." % cap_mm)
            return

        y_face = self.sign_face_y_mm()
        plane = self._plane_at(self.root.xZConstructionPlane, "y", y_face)
        sk = self.root.sketches.add(plane)
        outward = adsk.core.Vector3D.create(0.0, -1.0, 0.0)   # -Y is "out front"
        dist = _cm(SIGN_EMBOSS_MM) * (
            1.0 if plane.geometry.normal.dotProduct(outward) > 0 else -1.0)

        line_h = cap_mm * 1.6
        z_top = self.Z(SIGN_Z1) - (band_mm - n * line_h) * 0.5
        x_mid = self.X(0.0)
        embossed = 0
        for i, line in enumerate(SIGN_TEXT_LINES):
            z_line = z_top - (i + 1) * line_h + (line_h - cap_mm) * 0.5
            corner = sk.modelToSketchSpace(adsk.core.Point3D.create(
                _cm(x_mid - width_mm * 0.5), _cm(y_face), _cm(z_line)))
            diag = sk.modelToSketchSpace(adsk.core.Point3D.create(
                _cm(x_mid + width_mm * 0.5), _cm(y_face), _cm(z_line + cap_mm)))
            for font in SIGN_TEXT_FONTS:
                try:
                    ti = sk.sketchTexts.createInput2(line, _cm(cap_mm))
                    ti.setAsMultiLine(
                        corner, diag,
                        adsk.core.HorizontalAlignments.CenterHorizontalAlignment,
                        adsk.core.VerticalAlignments.MiddleVerticalAlignment, 0.0)
                    ti.fontName = font
                    txt = sk.sketchTexts.add(ti)
                    ei = self.root.features.extrudeFeatures.createInput(
                        txt, adsk.fusion.FeatureOperations.JoinFeatureOperation)
                    ei.setDistanceExtent(
                        False, adsk.core.ValueInput.createByReal(dist))
                    parts = adsk.core.ObjectCollection.create()
                    parts.add(target_body)
                    ei.participantBodies = parts
                    self.root.features.extrudeFeatures.add(ei)
                    embossed += 1
                    break
                except Exception:
                    continue
            else:
                _log(self.app, "WARNING: no available font could emboss '%s'."
                     % line)
        if embossed:
            _log(self.app, "  sign lettering embossed at %.1f mm cap height "
                           "(oversized vs true scale, for printability)."
                 % cap_mm)


# ===========================================================================
# ENTRY POINT
# ===========================================================================

def _largest_solid(root):
    solids = [root.bRepBodies.item(i) for i in range(root.bRepBodies.count)]
    solids = [s for s in solids if s.isSolid]
    if not solids:
        return None, []
    solids.sort(key=lambda b: b.volume, reverse=True)
    return solids[0], solids


def run(context):
    app = adsk.core.Application.get()
    ui = app.userInterface if app else None
    try:
        # -- document ------------------------------------------------------
        if USE_ACTIVE_DOCUMENT and app.activeProduct:
            design = adsk.fusion.Design.cast(app.activeProduct)
            if design is None:
                raise RuntimeError("The active document is not a Fusion design.")
        else:
            app.documents.add(adsk.core.DocumentTypes.FusionDesignDocumentType)
            design = adsk.fusion.Design.cast(app.activeProduct)

        design.unitsManager.distanceDisplayUnits = \
            adsk.fusion.DistanceUnits.MillimeterDistanceUnits

        # Direct modelling: no timeline entry per boolean, and
        # Component.bRepBodies.add() works without a BaseFeature.
        try:
            design.designType = adsk.fusion.DesignTypes.DirectDesignType
        except Exception:
            _log(app, "note: could not switch to direct modelling; "
                      "falling back to a BaseFeature on commit.")

        root = design.rootComponent
        root.name = "Hollywood Tower Hotel"

        # -- scale ---------------------------------------------------------
        scale, envelope, bounds = _compute_scale()
        x0, x1, y0, y1, z0, z1 = bounds
        x_shift = -(x0 + x1) * 0.5                      # centre footprint in X
        y_shift = -(y0 + y1) * 0.5                      # ...and in Y
        z_offset = BASE_T_MM if INCLUDE_BASE else 0.0   # sit on the slab

        _log(app, "=" * 64)
        _log(app, "Real-world mass: %.0f x %.0f x %.0f ft (tower top %.0f ft)"
             % (x1 - x0, y1 - y0, z1 - z0, TOWER_TOP_FT))
        _log(app, "Scale 1:%.1f" % (1.0 / scale))
        _log(app, "Target envelope: %.1f x %.1f x %.1f mm   (bed %.0f x %.0f x %.0f)"
             % (envelope[0], envelope[1], envelope[2],
                BED_X_MM, BED_Y_MM, BED_Z_MM))
        undersized = _audit_features(scale, app)
        if undersized:
            _log(app, "WARNING: under-size features: %s" % ", ".join(undersized))

        # -- build ---------------------------------------------------------
        b = TowerBuilder(app, root, scale, x_shift, y_shift, z_offset)

        _log(app, "building massing, bays and openings ...")
        b.build_masses()

        if INCLUDE_PARAPET:
            b.cut_parapet()
        if INCLUDE_SIGN:
            b.add_sign_plaque()
        if INCLUDE_ARCHES:
            _log(app, "cutting entry arches ...")
            b.cut_arches()
        if INCLUDE_BLAST:
            _log(app, "cutting storm damage ...")
            b.cut_blast()
        if INCLUDE_BASE:
            b.add_base((x0, x1, y0, y1))

        _log(app, "committing solid ...")
        body = b.commit()

        if INCLUDE_ROOFS:
            _log(app, "lofting roofs ...")
            b.build_roofs(body)
            # the combine above can invalidate the earlier body reference
            body, _ = _largest_solid(root)

        if INCLUDE_SIGN and INCLUDE_SIGN_TEXT and body:
            try:
                b.emboss_sign_text(body)
            except Exception:
                _log(app, "WARNING: sign lettering skipped:\n%s"
                     % traceback.format_exc())

        # -- verify --------------------------------------------------------
        body, solids = _largest_solid(root)
        if not body:
            raise RuntimeError("No solid body was produced.")

        bb = body.boundingBox
        for s in solids[1:]:
            bb.combine(s.boundingBox)
        size = ((bb.maxPoint.x - bb.minPoint.x) * 10.0,
                (bb.maxPoint.y - bb.minPoint.y) * 10.0,
                (bb.maxPoint.z - bb.minPoint.z) * 10.0)
        fits = (size[0] <= BED_X_MM and size[1] <= BED_Y_MM and size[2] <= BED_Z_MM)

        pitch = ROOF_PITCH_SAFE_DEG if SUPPORT_FREE_ROOFS else ROOF_PITCH_TRUE_DEG
        summary = "\n".join([
            "Hollywood Tower Hotel -- build complete",
            "",
            "  scale             1:%.1f" % (1.0 / scale),
            "  bounding box      %.2f x %.2f x %.2f mm" % size,
            "  print bed         %.0f x %.0f x %.0f mm" % (BED_X_MM, BED_Y_MM, BED_Z_MM),
            "  fits bed          %s" % (
                "YES" if fits else "NO -- raise BED_CLEARANCE_MM or disable the base"),
            "  solid bodies      %d" % len(solids),
            "  massing blocks    %d" % b.stats["masses"],
            "  bay recesses      %d" % b.stats["bays"],
            "  openings          %d (%d arched)" % (b.stats["windows"],
                                                    b.stats["arches"]),
            "  blast voids       %d" % b.stats["blast"],
            "  failed booleans   %d" % b.stats["failed"],
            "",
            "  roof pitch        %.0f deg %s" % (
                pitch,
                "(FDM-safe: no supports needed anywhere)" if SUPPORT_FREE_ROOFS
                else "(true pitch: roofs need supports; set "
                     "SUPPORT_FREE_ROOFS = True to avoid that)"),
            "  orientation       print as built, Z up, facade towards -Y",
        ])
        for line in summary.split("\n"):
            _log(app, line)
        _log(app, "=" * 64)

        try:
            app.activeViewport.fit()
        except Exception:
            pass

        if SHOW_DIALOG and ui:
            ui.messageBox(summary, "Hollywood Tower Hotel")

        return summary

    except Exception:
        detail = traceback.format_exc()
        if app:
            _log(app, "FAILED:\n" + detail)
        if SHOW_DIALOG and ui:
            ui.messageBox("Hollywood Tower build failed:\n\n" + detail)
        raise


